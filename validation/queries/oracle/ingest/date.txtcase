// part: metadata

[tags]
sql-type-name = "DATE"
field-type-name = "DATE"
caveats = [
    "Oracle has no 64-bit integer type: the int64 `idx` column becomes NUMBER(19), read back as decimal128(19, 0).",
    "Oracle DATE carries a time of day: it is read back as timestamp[s] (date32 with adbc.oracle.date_mode=date32).",
]

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "idx",
            "format": "d:19,0",
            "flags": [
                "nullable"
            ]
        },
        {
            "name": "value",
            "format": "tss:",
            "flags": [
                "nullable"
            ]
        }
    ]
}

// part: expected

{"idx": "0", "value": 0}
{"idx": "1", "value": 1684108800}
{"idx": "2", "value": -315532800}
{"idx": "3", "value": 6311520000}
{"idx": "4", "value": null}
