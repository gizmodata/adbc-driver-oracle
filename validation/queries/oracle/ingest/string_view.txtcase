// part: metadata

[tags]
sql-type-name = "VARCHAR2(4000)"
field-type-name = "VARCHAR2"
caveats = [
    "Oracle has no 64-bit integer type: the int64 `idx` column becomes NUMBER(19), read back as decimal128(19, 0).",
    "Oracle stores an empty string or byte string as NULL.",
]

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "idx",
            "format": "d:19,0",
            "flags": [
                "nullable"
            ]
        },
        {
            "name": "value",
            "format": "u",
            "flags": [
                "nullable"
            ]
        }
    ]
}

// part: expected

{"idx": "0", "value": null}
{"idx": "1", "value": "hello world"}
{"idx": "2", "value": "Special chars: !@#$%^&*()_+-=[]{}|;:,.<>?/\"\\"}
{"idx": "3", "value": "Unicode: こんにちは, 世界!"}
{"idx": "4", "value": "A very long string that tests the limits of string handling in various systems. This string is intentionally verbose to ensure that databases can properly handle longer text values without truncation or other issues."}
{"idx": "5", "value": null}
