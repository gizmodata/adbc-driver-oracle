// part: metadata

[tags]
sql-type-name = "RAW(15)"
field-type-name = "RAW"
caveats = [
    "Oracle has no 64-bit integer type: the int64 `idx` column becomes NUMBER(19), read back as decimal128(19, 0).",
]

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "idx",
            "format": "d:19,0",
            "flags": [
                "nullable"
            ]
        },
        {
            "name": "value",
            "format": "z",
            "flags": [
                "nullable"
            ]
        }
    ]
}

// part: expected

{"idx": "0", "value": "AAAAAAAAAAAAAAAAAAAA"}
{"idx": "1", "value": "AAECAwQFBgcICQoLDA0O"}
{"idx": "2", "value": "DxAREhMUFRYXGBkaGxwd"}
{"idx": "3", "value": "eHl6e3x9fn+AgYKDhIWG"}
{"idx": "4", "value": "vr/AwcLDxADGx8jJysvM"}
{"idx": "5", "value": null}
