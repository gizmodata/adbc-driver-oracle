// part: metadata

sort-keys = [["res", "ascending"]]

[tags]
sql-type-name = "RAW(1000)"
field-type-name = "RAW"
caveats = [
    "Oracle stores an empty string or byte string as NULL.",
]

// part: setup_query

CREATE TABLE test_binary (
    res RAW(1000)
);

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "res",
            "format": "z",
            "flags": [
                "nullable"
            ]
        }
    ]
}

// part: expected

{"res": null}
{"res": null}
{"res": "3q2+7w=="}
{"res": "AA=="}
{"res": "AQAC"}
{"res": "44GT44KT44Gr44Gh44Gv44CB5LiW55WM77yB"}
