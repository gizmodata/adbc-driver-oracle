// part: metadata

[tags]
field-type-name = "DATE"
caveats = [
    "Oracle DATE carries a time of day: it is read back as timestamp[s] (date32 with adbc.oracle.date_mode=date32).",
]

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "res",
            "format": "tss:",
            "flags": [
                "nullable"
            ]
        }
    ]
}

