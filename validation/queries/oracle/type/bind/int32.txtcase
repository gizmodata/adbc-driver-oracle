// part: metadata

[tags]
sql-type-name = "NUMBER(10)"
field-type-name = "NUMBER"
caveats = [
    "Oracle has no SMALLINT/INTEGER types: NUMBER(p) with p <= 18 is read back as int64.",
]

// part: setup_query

CREATE TABLE test_int32 (
    res NUMBER(10)
);

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "res",
            "format": "l",
            "flags": [
                "nullable"
            ]
        }
    ]
}

// part: expected

{"res": null}
{"res": -2147483648}
{"res": 0}
{"res": 42}
{"res": 131072}
{"res": 2147483647}
