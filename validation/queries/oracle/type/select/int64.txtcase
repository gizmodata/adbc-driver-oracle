// part: metadata

[tags]
sql-type-name = "NUMBER(19)"
field-type-name = "NUMBER"
caveats = [
    "Oracle has no 64-bit integer type: NUMBER(19) can exceed int64, so it is read back as decimal128(19, 0).",
]

// part: setup_query

CREATE TABLE test_int64 (
    idx INTEGER,
    res NUMBER(19)
);

INSERT INTO test_int64 (idx, res) VALUES (1, 4294967296);
INSERT INTO test_int64 (idx, res) VALUES (2, 9223372036854775807);
INSERT INTO test_int64 (idx, res) VALUES (3, -9223372036854775808);
INSERT INTO test_int64 (idx, res) VALUES (4, 0);
INSERT INTO test_int64 (idx, res) VALUES (5, NULL);

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "res",
            "format": "d:19,0",
            "flags": [
                "nullable"
            ]
        }
    ]
}

// part: expected

{"res": "4294967296"}
{"res": "9223372036854775807"}
{"res": "-9223372036854775808"}
{"res": "0"}
{"res": null}
