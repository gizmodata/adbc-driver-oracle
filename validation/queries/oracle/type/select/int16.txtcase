// part: metadata

[tags]
sql-type-name = "NUMBER(5)"
field-type-name = "NUMBER"
caveats = [
    "Oracle has no SMALLINT/INTEGER types: NUMBER(p) with p <= 18 is read back as int64.",
]

// part: setup_query

CREATE TABLE test_int16 (
    idx INTEGER,
    res NUMBER(5)
);

INSERT INTO test_int16 (idx, res) VALUES (1, 16384);
INSERT INTO test_int16 (idx, res) VALUES (2, 32767);
INSERT INTO test_int16 (idx, res) VALUES (3, -32768);
INSERT INTO test_int16 (idx, res) VALUES (4, 0);
INSERT INTO test_int16 (idx, res) VALUES (5, NULL);

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "res",
            "format": "l",
            "flags": [
                "nullable"
            ]
        }
    ]
}

// part: expected

{"res": 16384}
{"res": 32767}
{"res": -32768}
{"res": 0}
{"res": null}
