// part: metadata

[tags]
sql-type-name = "BLOB"
field-type-name = "BLOB"
caveats = [
    "An empty (non-NULL) BLOB reads back as NULL: LOB columns are fetched inline, which does not tell the two apart (python-oracledb with fetch_lobs=False returns None as well).",
]

// part: setup_query

CREATE TABLE test_binary (
    idx INTEGER,
    res BLOB
);

INSERT INTO test_binary (idx, res) VALUES (1, HEXTORAW('e38193e38293e381abe381a1e381afe38081e4b896e7958cefbc81'));  -- 'こんにちは、世界！' in UTF-8
INSERT INTO test_binary (idx, res) VALUES (2, HEXTORAW('00'));
INSERT INTO test_binary (idx, res) VALUES (3, HEXTORAW('deadbeef'));
INSERT INTO test_binary (idx, res) VALUES (4, EMPTY_BLOB());
INSERT INTO test_binary (idx, res) VALUES (5, NULL);

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "res",
            "format": "z",
            "flags": [
                "nullable"
            ]
        }
    ]
}

// part: expected

{"res": "44GT44KT44Gr44Gh44Gv44CB5LiW55WM77yB"}
{"res": "AA=="}
{"res": "3q2+7w=="}
{"res": null}
{"res": null}
